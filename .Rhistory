wage[["grosswage"]] <- as.numeric(wage[["grosswage"]])
wage[["wage_month"]] <- trimws(wage[["wage_month"]])
wage[["wage_month"]]<- gsub("[^0-9.]", "", wage[["wage_month"]])
wage <- rename(wage, year_month=wage_month)
wage[["bonustotal"]] <- as.numeric(wage[["bonustotal"]])
